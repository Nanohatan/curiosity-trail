---
import Base from '../layouts/Base.astro';
import Trail from '../components/Trail.astro';
import { url } from '../lib/url';
---

<Base>
  <div class="intro">
    <h1>突発的活動の足跡</h1>
    <p class="streak" data-streak hidden></p>
  </div>

  <Trail stats />

  <section class="now" aria-labelledby="now-title">
    <h2 id="now-title">いまハマっているもの</h2>
    <p class="now-sub num" data-now-sub></p>
    <ul class="interest-list" data-now-list></ul>
    <p><a href={url('interests/')}>休眠中のものも見る</a></p>
  </section>
</Base>

<style is:global>
  .intro {
    margin: 2.5rem 0 2rem;
  }
  h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }
  .lede {
    margin: 0.75rem 0 0;
    color: var(--muted);
    max-width: 36em;
  }
  .streak {
    display: inline-block;
    margin: 1rem 0 0;
    font-size: var(--step--1);
    font-weight: 700;
    padding-left: 0.75rem;
    border-left: 3px solid var(--act-3);
  }
  .now {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 2px solid var(--ink);
  }
  .now h2 {
    font-size: var(--step-2);
  }
  .now-sub {
    color: var(--muted);
    font-size: var(--step--1);
    margin: 0.25rem 0 1.25rem;
  }
  .interest-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    border-top: 1px solid var(--rule);
  }
  .interest-list li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.1rem 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .interest-list a {
    font-family: var(--serif);
    font-weight: 700;
    font-size: var(--step-1);
    text-decoration: none;
  }
  .interest-list a:hover {
    text-decoration: underline;
  }
  .cat,
  .since,
  .count {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .count {
    grid-column: 2;
    grid-row: 1;
    align-self: center;
  }
  .cat {
    grid-column: 1;
  }
  .since {
    grid-column: 1;
  }
  @media (min-width: 640px) {
    .interest-list li {
      grid-template-columns: 1fr 9rem 9rem 4rem;
      align-items: baseline;
    }
    .cat,
    .since,
    .count {
      grid-column: auto;
      grid-row: auto;
    }
    .count {
      text-align: right;
    }
  }
</style>
