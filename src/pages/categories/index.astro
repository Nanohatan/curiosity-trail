---
import Base from '../../layouts/Base.astro';
---

<Base title="カテゴリ">
  <div class="cloud-hero">
    <div class="cloud" data-cloud role="img" aria-label="カテゴリとハマりごとのワードクラウド"></div>
    <h1>カテゴリ</h1>
    <p class="lede num" data-category-lede></p>
  </div>
  <div data-category-list></div>
</Base>

<style is:global>
  .cloud-hero {
    margin: 1.5rem 0 3rem;
  }
  .cloud {
    min-height: 12rem;
  }
  .cloud svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 70vh;
    overflow: visible;
  }
  .cloud a {
    text-decoration: none;
  }
  .cloud text {
    opacity: 0;
    animation: cloud-in 0.6s ease-out forwards;
    transition: opacity 0.2s;
  }
  .cloud a:hover text,
  .cloud a:focus-visible text {
    text-decoration: underline;
  }
  .cloud:has(a:hover) a:not(:hover) text {
    opacity: 0.35;
  }
  @keyframes cloud-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .cloud-hero h1 {
    font-size: clamp(2rem, 6vw, 3.25rem);
    margin-top: 1.5rem;
  }
  .cloud-hero .lede {
    color: var(--muted);
    margin: 0.25rem 0 0;
  }
  .cat-section {
    margin-bottom: 2.5rem;
    scroll-margin-top: 1rem;
  }
  .cat-section h2 {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--step-2);
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--c);
  }
  .cat-section h2::before {
    content: '';
    width: 0.6em;
    height: 0.6em;
    border-radius: 50%;
    background: var(--c);
    flex: none;
    align-self: center;
  }
  .cat-section .n {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .cat-items {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .cat-items li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .cat-items a {
    font-size: var(--step-1);
    text-decoration: none;
    margin-right: auto;
  }
  .cat-items a:hover {
    text-decoration: underline;
  }
  .cat-items span {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .cat-items .dormant a {
    color: var(--muted);
  }
</style>
