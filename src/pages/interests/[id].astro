---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Trail from '../../components/Trail.astro';
import { loadTrail, statusLabel } from '../../lib/data';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const { interestEntries, interests, logs } = await loadTrail();
  return interestEntries.map((entry) => ({
    params: { id: entry.id },
    props: {
      entry,
      interest: interests.find((i) => i.id === entry.id)!,
      logs: logs.filter((l) => l.interest === entry.id),
    },
  }));
}

const { entry, interest, logs } = Astro.props;
const { Content } = await render(entry);
const first = logs[0]?.date;
const last = logs.at(-1)?.date;
const activeDays = new Set(logs.map((l) => l.date)).size;
const fmt = (iso?: string) => (iso ? iso.replaceAll('-', '.') : '—');
---

<Base title={interest.name} description={entry.data.summary}>
  <p class="back"><a href={url('interests/')}>ハマったもの一覧</a></p>
  <header class="head">
    <h1>{interest.name}</h1>
    <p class="meta">
      <span>{interest.category}</span>
      <span class={`status status-${interest.status}`}>{statusLabel[interest.status]}</span>
      <span class="num">{fmt(interest.started)} から</span>
    </p>
    {entry.data.summary && <p class="summary">{entry.data.summary}</p>}
  </header>

  <dl class="facts num">
    <div><dt>記録</dt><dd>{logs.length} 件</dd></div>
    <div><dt>動いた日</dt><dd>{activeDays} 日</dd></div>
    <div><dt>最初の記録</dt><dd>{fmt(first)}</dd></div>
    <div><dt>最後の記録</dt><dd>{fmt(last)}</dd></div>
  </dl>

  <Trail logs={logs} interests={[interest]} label={`${interest.name}の日ごとの記録`} />

  {
    entry.body?.trim() && (
      <section class="body" aria-label="メモ">
        <Content />
      </section>
    )
  }
</Base>

<style>
  .back {
    font-size: var(--step--1);
    margin: 1.5rem 0 0;
  }
  .head {
    margin: 1rem 0 2rem;
  }
  h1 {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 800;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--muted);
    font-size: var(--step--1);
    margin: 0.75rem 0 0;
  }
  .status {
    font-weight: 700;
    color: var(--ink);
  }
  .status-paused,
  .status-done {
    color: var(--muted);
  }
  .summary {
    max-width: 36em;
    margin: 1rem 0 0;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0 0 2.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 640px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-family: var(--serif);
    font-weight: 700;
    font-size: var(--step-1);
  }
  .body {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--ink);
    max-width: 40em;
    line-height: 1.9;
  }
</style>
