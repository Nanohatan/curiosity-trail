---
import Base from '../../layouts/Base.astro';
import Trail from '../../components/Trail.astro';
import { url } from '../../lib/url';
---

<Base title="ハマりごと">
  <p class="back"><a href={url('interests/')}>ハマったもの一覧</a></p>
  <div data-interest-detail></div>
  <Trail label="日ごとの記録" />
</Base>

<style is:global>
  .back {
    font-size: var(--step--1);
    margin: 1.5rem 0 0;
  }
  .head {
    margin: 1rem 0 2rem;
  }
  h1 {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 800;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--muted);
    font-size: var(--step--1);
    margin: 0.75rem 0 0;
  }
  .status {
    font-weight: 700;
    color: var(--ink);
  }
  .status-dormant {
    color: var(--muted);
  }
  .summary {
    max-width: 36em;
    margin: 1rem 0 0;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0 0 2.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 640px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-family: var(--serif);
    font-weight: 700;
    font-size: var(--step-1);
  }
  .body {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--ink);
    max-width: 40em;
    line-height: 1.9;
  }
  .heat {
    margin: 2rem 0;
  }
  .heat h3 {
    font-size: var(--step-0);
    margin-bottom: 0.5rem;
  }
  .heat-wrap {
    position: relative;
    padding-top: 2rem; /* 吹き出しの置き場所。線に重ならないようグラフの上に出す */
  }
  .heat-wrap svg {
    display: block;
    overflow: visible;
    touch-action: pan-y;
  }
  .heat-wrap svg:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 4px;
  }
  .heat-grid {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .heat-base {
    stroke: var(--muted);
    stroke-width: 1;
  }
  .heat-label {
    fill: var(--muted);
    font-size: 11px;
  }
  .heat-line {
    fill: none;
    stroke: var(--act-3);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .heat-dot {
    fill: var(--act-3);
    stroke: var(--bg);
    stroke-width: 2;
  }
  .heat-cross {
    stroke: var(--muted);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .heat-tip {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    max-width: min(18rem, 90%);
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    background: var(--ink);
    color: var(--bg);
    font-size: var(--step--1);
    line-height: 1.4;
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
