---
import Base from '../../layouts/Base.astro';
import Trail from '../../components/Trail.astro';
import { url } from '../../lib/url';
---

<Base title="ハマりごと">
  <p class="back"><a href={url('interests/')}>ハマったもの一覧</a></p>
  <div data-interest-detail></div>
  <Trail label="日ごとの記録" />
</Base>

<style is:global>
  .back {
    font-size: var(--step--1);
    margin: 1.5rem 0 0;
  }
  .head {
    margin: 1rem 0 2rem;
  }
  h1 {
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    font-weight: 800;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--muted);
    font-size: var(--step--1);
    margin: 0.75rem 0 0;
  }
  .status {
    font-weight: 700;
    color: var(--ink);
  }
  .status-dormant {
    color: var(--muted);
  }
  .summary {
    max-width: 36em;
    margin: 1rem 0 0;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0 0 2.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 640px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .facts dt {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    font-family: var(--serif);
    font-weight: 700;
    font-size: var(--step-1);
  }
  .body {
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 2px solid var(--ink);
    max-width: 40em;
    line-height: 1.9;
  }
  .heat {
    margin: 0 0 2.5rem;
  }
  .heat h2 {
    font-size: var(--step-1);
    margin-bottom: 0.75rem;
  }
  .heat-chart {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, calc(var(--n) * 30px + 4px));
    gap: 0.5rem;
  }
  .heat-wrap {
    position: relative;
  }
  .heat-axis {
    position: relative;
    height: 10rem;
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .heat-axis span {
    position: absolute;
    right: 0;
    bottom: var(--y);
    transform: translateY(50%);
    line-height: 1;
  }
  .heat-plot {
    position: relative;
    height: 10rem;
    /* 熱量 1〜5 の目盛り線（控えめに） */
    background: repeating-linear-gradient(
      to bottom,
      var(--rule) 0 1px,
      transparent 1px 20%
    );
    border-bottom: 1px solid var(--muted);
    overflow-x: auto;
  }
  .heat-bars {
    list-style: none;
    margin: 0;
    padding: 0 2px;
    height: 100%;
    display: flex;
    align-items: flex-end;
    gap: 2px;
  }
  .heat-bar {
    flex: 1 1 0;
    min-width: 4px;
    height: 100%;
    display: flex;
    align-items: flex-end;
    cursor: default;
    outline-offset: 1px;
  }
  .heat-bar::after {
    content: '';
    width: 100%;
    height: var(--h);
    background: var(--act-3);
    border-radius: 4px 4px 0 0;
    transition: background 0.15s;
  }
  .heat-bar:hover::after,
  .heat-bar:focus-visible::after {
    background: var(--act-4);
  }
  .heat-tip {
    position: absolute;
    top: -0.5rem;
    transform: translateX(-50%);
    max-width: min(18rem, 90%);
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    background: var(--ink);
    color: var(--bg);
    font-size: var(--step--1);
    line-height: 1.4;
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .heat-dates {
    display: flex;
    justify-content: space-between;
    max-width: calc(var(--n) * 30px + 4px);
    margin: 0.35rem 0 0 1.75rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
