---
import Base from '../../layouts/Base.astro';
---

<Base title="やりたいこと">
  <h1>やりたいこと</h1>
  <p class="lede num" data-wishes-lede></p>
  <ul class="wish-list" data-wishes></ul>
</Base>

<style is:global>
  h1 {
    font-size: clamp(2rem, 6vw, 3.25rem);
    margin-top: 2.5rem;
  }
  .lede {
    color: var(--muted);
    margin: 0.5rem 0 2rem;
  }
  .wish-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .wish-list li {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .wish-title {
    margin: 0;
    font-size: var(--step-1);
  }
  .wish-note {
    margin: 0.15rem 0 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
  @media (min-width: 720px) {
    .wish-list li {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
      align-items: baseline;
      column-gap: 1rem;
    }
    .wish-note {
      margin: 0;
      text-align: right;
    }
  }
</style>
