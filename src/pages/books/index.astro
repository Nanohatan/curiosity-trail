---
import Base from '../../layouts/Base.astro';
---

<Base title="読書予定メモ">
  <h1>読書予定メモ</h1>
  <p class="lede num" data-books-lede></p>
  <ul class="book-list" data-books></ul>
</Base>

<style is:global>
  h1 {
    font-size: clamp(2rem, 6vw, 3.25rem);
    margin-top: 2.5rem;
  }
  .lede {
    color: var(--muted);
    margin: 0.5rem 0 2rem;
  }
  .book-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .book-list li {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    column-gap: 0.75rem;
    row-gap: 0.1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .book-list li > :not(.book-check) {
    grid-column: 2;
  }
  /* 読み終わった本はチェック、まだの本は空の丸 */
  .book-check {
    grid-column: 1;
    grid-row: 1 / span 3;
    align-self: start;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.3rem;
    border: 1.5px solid var(--rule);
    border-radius: 50%;
    color: transparent;
  }
  .is-done .book-check {
    background: var(--act-3);
    border-color: var(--act-3);
    color: var(--bg);
  }
  .book-check svg {
    width: 0.8rem;
    height: 0.8rem;
  }
  .book-main {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6rem;
  }
  .book-title {
    font-size: var(--step-1);
    text-decoration: none;
  }
  .book-title:hover {
    text-decoration: underline;
  }
  .is-done .book-title {
    color: var(--muted);
  }
  .book-done {
    font-size: 0.6875rem;
    color: var(--act-3);
  }
  .book-author,
  .book-pub {
    font-size: var(--step--1);
    color: var(--muted);
  }
  @media (min-width: 720px) {
    .book-list li {
      grid-template-columns: 1.5rem minmax(0, 1fr) minmax(0, 14rem) 11rem;
      align-items: baseline;
      column-gap: 1rem;
    }
    .book-list li > :not(.book-check) {
      grid-column: auto;
    }
    .book-check {
      grid-row: auto;
      align-self: center;
      margin-top: 0;
    }
    .book-pub {
      text-align: right;
    }
  }
</style>
